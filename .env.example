# Kopyalayıp .env olarak kaydedin ve gerçek değerleri girin.

# --- Veritabanı ---
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/nocpos?schema=public"

# --- Telegram Bot (Aşama 3) ---
# BotFather'dan alınan token. Boş bırakılırsa bot mesajları gönderilmez,
# yalnızca konsola loglanır (yerel geliştirmede dev-login yeterlidir).
TELEGRAM_BOT_TOKEN=""
# @ olmadan bot kullanıcı adı, örn. "poskontrol_bot"
TELEGRAM_BOT_USERNAME=""
# Telegram webhook isteklerini doğrulamak için rastgele bir sır
# (setWebhook çağrılırken secret_token olarak aynısı gönderilmeli).
TELEGRAM_WEBHOOK_SECRET=""

# --- Oturum ---
SESSION_COOKIE_NAME="poskontrol_session"

# --- Yerel geliştirme girişi ---
# "true" olduğunda ve NODE_ENV production değilken /login sayfasında
# Telegram'sız, seed edilmiş kullanıcılarla anında giriş seçeneği görünür.
# Production'da bu değişken tanımlanmamalı/false olmalıdır.
DEV_LOGIN_ENABLED="true"
