# Sunucuda docker-compose ile self-host ederken kullanılan ortam dosyası.
# Bu dosyayı sunucuda `.env` adıyla (docker-compose.yml ile aynı dizinde)
# oluşturun — repo'ya asla commit etmeyin (.gitignore zaten `.env*` içeriyor).
# Compose hem konteynerlere bu değişkenleri enjekte etmek için (`env_file`)
# hem de docker-compose.yml içindeki `${...}` yer tutucularını doldurmak
# için bu dosyayı okur.

# --- Postgres konteyneri ---
POSTGRES_USER="poskontrol"
POSTGRES_PASSWORD=""
POSTGRES_DB="poskontrol"

# --- Veritabanı — app/migrate konteynerlerinin göreceği bağlantı dizesi.
# Host adı "postgres" = docker-compose'daki servis adı (docker network
# üzerinden erişilir, dışa portu açılmaz). Kullanıcı/şifre/db adı yukarıdaki
# POSTGRES_* değerleriyle birebir eşleşmeli.
DATABASE_URL="postgresql://poskontrol:CHANGE_ME@postgres:5432/poskontrol?schema=public"

# --- Telegram Bot (Aşama 3) — bot henüz kurulmadıysa boş bırakın.
# Boşken bot mesajları yalnızca konsola loglanır, tenant girişi Telegram
# onayı gerektirdiği için bot olmadan çalışmaz.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# --- Oturum çerezleri ---
SESSION_COOKIE_NAME="poskontrol_session"
ADMIN_SESSION_COOKIE_NAME="poskontrol_admin_session"

# --- Uygulama URL'i — Telegram bildirim linkleri ve sunucu taraflı
# mutlak URL oluşturma için kullanılır. Domain yoksa sunucunun IP'si +
# http:// ile (SSL yok), domain eklendiğinde https://domain olarak
# güncelleyip konteynerleri yeniden başlatın.
NEXT_PUBLIC_APP_URL="http://SUNUCU_IP_ADRESI"

# --- Production'da DEV_LOGIN_ENABLED tanımlanmamalı (kod NODE_ENV=production
# olduğunda zaten devre dışı bırakıyor, ama netlik için burada da yok).
